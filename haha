local function makeButton(text, y, color)
	local b = Instance.new("TextButton")
	b.Size = UDim2.new(1, -20, 0, 32)
	b.Position = UDim2.new(0, 10, 0, y)
	b.BackgroundColor3 = color
	b.BorderSizePixel = 0
	b.Text = text
	b.TextColor3 = Color3.new(1, 1, 1)
	b.Font = Enum.Font.GothamMedium
	b.TextSize = 13
	b.Parent = frame
	Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)
	return b
end

local nearestBtn = makeButton("TP to Nearest Prompt", 40, Color3.fromRGB(60, 120, 220))
local farthestBtn = makeButton("TP to Farthest Prompt", 78, Color3.fromRGB(200, 90, 70))
local autoBtn = makeButton("Auto-trigger: OFF", 116, Color3.fromRGB(70, 70, 80))

local function teleportTo(mode)
	local root = getRoot()
	if not root then
		status.Text = "No character found."
		return
	end

	local prompt, pos, dist = findPrompt(mode)
	if not prompt then
		status.Text = "No prompts found."
		return
	end

	root.CFrame = CFrame.new(pos + Vector3.new(0, HEIGHT_OFFSET, 0))
	status.Text = string.format("Teleported to %s (%.0f studs away)", prompt.Parent.Name, dist)

	if autoTrigger and fireproximityprompt then
		task.wait(0.15)
		pcall(fireproximityprompt, prompt)
	end
end

nearestBtn.MouseButton1Click:Connect(function() teleportTo("nearest") end)
farthestBtn.MouseButton1Click:Connect(function() teleportTo("farthest") end)

autoBtn.MouseButton1Click:Connect(function()
	autoTrigger = not autoTrigger
	autoBtn.Text = "Auto-trigger: " .. (autoTrigger and "ON" or "OFF")
	autoBtn.BackgroundColor3 = autoTrigger and Color3.fromRGB(60, 160, 90) or Color3.fromRGB(70, 70, 80)
	if autoTrigger and not fireproximityprompt then
		status.Text = "Your executor doesn't support fireproximityprompt."
	end
end)

-- Dragging
local dragging, dragStart, startPos
title.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragStart = input.Position
		startPos = frame.Position
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
		local delta = input.Position - dragStart
		frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = false
	end
end)
